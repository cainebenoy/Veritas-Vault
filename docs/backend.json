{
  "entities": {
    "Archive": {
      "title": "Archive",
      "description": "Represents the core metadata for an archived URL.",
      "type": "object",
      "properties": {
        "originalUrl": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ipfsUrl": { "type": "string" },
        "blockchainTx": { "type": "string" },
        "screenshotUrl": { "type": "string", "format": "uri" },
        "status": { "type": "string", "enum": ["complete", "failed"] }
      },
      "required": ["originalUrl", "title", "createdAt", "status"]
    },
    "ArchiveContent": {
      "title": "ArchiveContent",
      "description": "Stores the large HTML content of an archived page.",
      "type": "object",
      "properties": {
        "content": { "type": "string" }
      },
      "required": ["content"]
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/archives/{archiveId}": {
      "schema": { "$ref": "#/backend/entities/Archive" },
      "description": "A global collection of all archived pages."
    },
    "/archive_content/{archiveId}": {
      "schema": { "$ref": "#/backend/entities/ArchiveContent" },
      "description": "Stores the large HTML content for a corresponding archive document."
    }
  }
}
