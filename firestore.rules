rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read access to the list of archives and individual archive metadata.
    // This allows anyone to view the gallery and archive detail pages.
    match /archives/{archiveId} {
      allow read: if true;
      
      // WARNING: Temporarily allow any write for the hackathon.
      // In a production app, this should be restricted, e.g., `if request.auth != null;`
      allow write: if true;
    }

    // Allow public read of archive content.
    // This lets the iframe on the detail page load the content.
    match /archive_content/{archiveId} {
      allow read: if true;

      // WARNING: Temporarily allow any write for the hackathon.
      // In a production app, this should be restricted.
      allow write: if true;
    }
  }
}
