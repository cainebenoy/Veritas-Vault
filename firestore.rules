/**
 * @fileOverview Firestore Security Rules for the Archive application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, where each user can only access their own archive data.
 *
 * Data Structure:
 * All archive data is nested under /users/{userId}/archives/{archiveId}.  This structure ensures that all reads and writes can be scoped to the authenticated user.
 *
 * Key Security Decisions:
 * - Users cannot list all archives across the entire database.  `list` operations are scoped to a single user's archives.
 * - Data shape is not strictly enforced, but the rules do enforce ownership via path consistency.
 * - No denormalization is required because the path-based ownership model provides adequate authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to individual archive documents within a user's collection.
     * @path /users/{userId}/archives/{archiveId}
     * @allow (create) - Authenticated user with UID 'user123' can create a new archive document under /users/user123/archives/archive456 if the document's `id` field also equals 'archive456'.
     * @allow (get) - Authenticated user with UID 'user123' can read archive document /users/user123/archives/archive456.
     * @allow (list) - Authenticated user with UID 'user123' can list all archive documents under /users/user123/archives.
     * @allow (update) - Authenticated user with UID 'user123' can update archive document /users/user123/archives/archive456.
     * @allow (delete) - Authenticated user with UID 'user123' can delete archive document /users/user123/archives/archive456.
     * @deny (create) - Authenticated user with UID 'user123' cannot create an archive document under /users/user456/archives.
     * @deny (get) - Authenticated user with UID 'user123' cannot read archive document /users/user456/archives/archive456.
     * @deny (update) - Authenticated user with UID 'user123' cannot update archive document /users/user456/archives/archive456.
     * @deny (delete) - Authenticated user with UID 'user123' cannot delete archive document /users/user456/archives/archive456.
     * @principle Enforces document ownership for all operations within the user's data tree.
     */
    match /users/{userId}/archives/{archiveId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the requesting user is the owner of the resource
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Helper function to check if the requesting user is the owner of the existing resource
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Allow reads (get) by the owner.
      allow get: if isOwner(userId);

      // Allow listing archives only for the owner.
      allow list: if isOwner(userId);

      // Allow creation if the user is signed in and the userId matches the authenticated user's ID, and the archiveId matches the archive document's id field.
      allow create: if isOwner(userId) && request.resource.data.id == archiveId;

      // Allow updates if the user is the owner and the document exists, and the id field is immutable.
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;

      // Allow deletion if the user is the owner and the document exists.
      allow delete: if isExistingOwner(userId);
    }
  }
}