rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read access to the list of archives and individual archive metadata.
    // This allows anyone to view the gallery and archive detail pages.
    match /archives/{archiveId} {
      allow read: if true;
      
      // Allow creation of new archives only by authenticated users.
      // In our app, we use anonymous authentication to grant this ability.
      // We also validate that the incoming data has the required fields.
      allow create: if request.auth != null
                      && 'originalUrl' in request.resource.data
                      && 'title' in request.resource.data
                      && 'status' in request.resource.data;
                      
      // Do not allow updates or deletes for this simple use case.
      allow update, delete: if false;
    }

    // Allow public read of archive content.
    // This lets the iframe on the detail page load the content.
    match /archive_content/{archiveId} {
      allow read: if true;

      // Only authenticated users can create the content document.
      // This write should happen in the same server action as the archive creation.
      allow create: if request.auth != null;

      // Do not allow updates or deletes.
      allow update, delete: if false;
    }
  }
}
